rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(coupleId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    match /users/{uid} {
      // Readable only by yourself and your paired partner.
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || (
          resource.data.coupleId != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleId
              == resource.data.coupleId
        )
      );
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Invite-code lookup: get-only (no listing), so codes can't be enumerated.
    match /invites/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['coupleId', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if request.auth != null;
    }

    match /couples/{coupleId} {
      // Members only — except a still-forming couple, which the invited
      // partner (who got the id from the invite doc) must be able to read.
      allow get: if request.auth != null && (
        request.auth.uid in resource.data.members
        || resource.data.members.size() < 2
      );
      allow list: if request.auth != null
        && request.auth.uid in resource.data.members;

      // Creating a couple: you are its only member.
      allow create: if request.auth != null
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] == request.auth.uid;

      // Account deletion: a member may delete the couple and its data.
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;

      // Updating: either you're already a member, or you're joining an
      // incomplete couple by appending yourself as the second member.
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (
          resource.data.members.size() == 1
          && request.resource.data.members.size() == 2
          && request.resource.data.members[0] == resource.data.members[0]
          && request.resource.data.members[1] == request.auth.uid
        )
      );

      // All couple data (messages, notes, answers, todos, call signaling, …)
      // at any depth is private to the two members.
      match /{document=**} {
        allow read, write: if isMember(coupleId);
      }
    }
  }
}
