rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(coupleId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    match /users/{uid} {
      // Readable only by yourself and your paired partner.
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || (
          resource.data.coupleId != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleId
              == resource.data.coupleId
        )
      );
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /couples/{coupleId} {
      // Readable by any signed-in user so the invite-code lookup query works.
      allow read: if request.auth != null;

      // Creating a couple: you are its only member.
      allow create: if request.auth != null
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] == request.auth.uid;

      // Updating: either you're already a member, or you're joining an
      // incomplete couple by appending yourself as the second member.
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (
          resource.data.members.size() == 1
          && request.resource.data.members.size() == 2
          && request.resource.data.members[0] == resource.data.members[0]
          && request.resource.data.members[1] == request.auth.uid
        )
      );

      // All couple data (messages, notes, daily answers, events, …) is
      // private to the two members.
      match /{subcollection}/{docId} {
        allow read, write: if isMember(coupleId);
      }
    }
  }
}
